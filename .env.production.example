# Pickup MaaS — Production 환경변수 예시
# cp .env.production.example .env.production 후 값을 채우세요

# ── Rails Master Key ─────────────────────────────────────────
# pickup_rails/config/master.key 파일의 내용
RAILS_MASTER_KEY=

# ── API URL (Frontend → Rails) ────────────────────────────────
# 서버의 실제 도메인 또는 IP
NEXT_PUBLIC_RAILS_API_URL=http://pickup-api.158.247.235.31.nip.io/api/v1

# ── FCM (Firebase Cloud Messaging) ───────────────────────────
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# ── VRP 마이크로서비스 ─────────────────────────────────────────
VRP_SERVICE_URL=http://vrp:8001
KAKAO_REST_API_KEY=

# ── 토스페이먼츠 ──────────────────────────────────────────────
TOSS_SECRET_KEY=
TOSS_CLIENT_KEY=
