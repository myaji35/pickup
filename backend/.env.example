# ============================================================================
# Core Configuration
# ============================================================================

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pickup_dev?schema=public"

# JWT Authentication (Phase 11 - Updated field names)
JWT_ACCESS_SECRET="your-super-secret-jwt-access-key-min-32-chars-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key-min-32-chars-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3012
NODE_ENV=development

# CORS (Frontend runs on 3000, Backend on 3012)
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# File Upload
MAX_FILE_SIZE_MB=10

# ============================================================================
# Q1: AI Route Optimization + Real-time Notifications
# ============================================================================

# 🗺️ 카카오맵 API (필수 - 메인 지도 솔루션)
# - 주소 검증 및 지오코딩 (Local API)
# - 거리 계산 (Mobility API - 길찾기)
# - 무료 할당량: Geocoding 300K/일, 길찾기 100K/일
# 발급: https://developers.kakao.com/
KAKAO_REST_API_KEY="your-kakao-rest-api-key"

# Firebase Cloud Messaging (Push 알림)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"

# Redis (Queue, Cache, Pub/Sub)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379"

# ============================================================================
# Fallback / Optional APIs
# ============================================================================

# Naver Maps API (Fallback - 카카오 API 실패 시)
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# Google Maps API (Optional - 더 정확한 거리 계산 필요 시)
# 비용: Distance Matrix $5/1K, Roads API $5/1K
# 카카오맵으로 충분하면 설정 불필요
GOOGLE_MAPS_API_KEY=""

# ============================================================================
# Q3: GPS Tracking & BI Dashboard
# ============================================================================

# 카카오 Mobility API 재사용 (위에서 설정)

# Analytics Refresh Schedule
ANALYTICS_REFRESH_CRON="0 1 * * *"  # 매일 새벽 1시

# ============================================================================
# Q4: SMS Notifications (Optional)
# ============================================================================

# NHN Cloud SMS (긴급 알림용)
NHN_SMS_APP_KEY=""
NHN_SMS_SECRET_KEY=""
NHN_SMS_SENDER_NUMBER=""

# ============================================================================
# Production Settings (향후 추가)
# ============================================================================

# AWS S3 (파일 업로드)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_S3_BUCKET=""
# AWS_REGION="ap-northeast-2"

# Sentry (에러 트래킹)
# SENTRY_DSN=""

# Logging
LOG_LEVEL="debug"
